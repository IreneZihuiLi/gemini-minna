page {
  min-height: 100%;
  background: #f8fafc;
  color: #1e293b;
  font-family: -apple-system, BlinkMacSystemFont, "Noto Sans SC", "Noto Sans JP", sans-serif;
}

button {
  box-sizing: border-box;
}

.safe-page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.muted {
  color: #94a3b8;
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.audio-btn {
  width: 72rpx;
  height: 72rpx;
  min-width: 72rpx;
  max-width: 72rpx;
  flex: 0 0 72rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  border: 0;
  background: #4f46e5;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
  box-shadow: 0 6rpx 14rpx rgba(79, 70, 229, 0.28);
}

.audio-btn.small {
  width: 64rpx;
  height: 64rpx;
  min-width: 64rpx;
  max-width: 64rpx;
  flex: 0 0 64rpx;
  background: #eef2ff;
  color: #4f46e5;
  font-size: 30rpx;
  box-shadow: none;
}

.audio-btn-hover {
  transform: scale(0.92);
  opacity: 0.85;
}

.card-hover {
  transform: scale(0.985);
  opacity: 0.92;
}

.audio-btn::after,
.plain-btn::after {
  border: 0;
}
