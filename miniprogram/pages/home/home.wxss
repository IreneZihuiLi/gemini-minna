.home {
  padding-left: 24rpx;
  padding-right: 24rpx;
}

.hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.hero > view {
  flex: 1;
  min-width: 0;
}

.eyebrow {
  color: #4f46e5;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.title {
  margin-top: 10rpx;
  color: #0f172a;
  font-size: 54rpx;
  font-weight: 900;
  line-height: 1.15;
}

.subtitle {
  margin-top: 12rpx;
  color: #64748b;
  font-size: 25rpx;
  line-height: 1.5;
  max-width: 410rpx;
}

.collection-btn {
  flex: 0 0 auto;
  margin: 0;
  width: 260rpx;
  max-width: 40vw;
  padding: 16rpx 0;
  border-radius: 999rpx;
  background: #111827;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
}

.lesson-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 20rpx;
  width: 100%;
}

.lesson-card {
  margin: 0;
  width: 100%;
  padding: 24rpx 18rpx;
  text-align: left;
  line-height: 1.35;
  min-width: 0;
  overflow: hidden;
}

.lesson-card[disabled] {
  opacity: 0.45;
}

.lesson-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  min-width: 0;
}

.lesson-no {
  min-width: 0;
  color: #64748b;
  font-size: 23rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status {
  flex: 0 0 auto;
  border-radius: 999rpx;
  padding: 5rpx 10rpx;
  background: #f1f5f9;
  color: #94a3b8;
  font-size: 18rpx;
  font-weight: 900;
}

.status.ready {
  background: #dcfce7;
  color: #15803d;
}

.lesson-title {
  margin-top: 28rpx;
  color: #0f172a;
  font-size: 37rpx;
  font-weight: 900;
}

.stats {
  display: flex;
  flex-wrap: wrap;
  gap: 9rpx 7rpx;
  margin-top: 20rpx;
  min-width: 0;
}

.stats text {
  padding: 6rpx 8rpx;
  border-radius: 10rpx;
  background: #f8fafc;
  color: #64748b;
  font-size: 20rpx;
  font-weight: 700;
  white-space: nowrap;
}
