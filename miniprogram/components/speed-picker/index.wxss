.speed-picker {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 0 0 24rpx;
}

.speed-label {
  flex: 0 0 auto;
  color: #64748b;
  font-size: 24rpx;
  font-weight: 800;
}

.speed-options {
  display: flex;
  flex: 1;
  background: #e2e8f0;
  border-radius: 999rpx;
  padding: 6rpx;
}

.speed-option {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: #475569;
  transition: background 0.1s ease, color 0.1s ease;
}

.speed-option.active {
  background: #4f46e5;
  color: #ffffff;
  box-shadow: 0 4rpx 10rpx rgba(79, 70, 229, 0.28);
}

.speed-option-hover {
  opacity: 0.8;
}
